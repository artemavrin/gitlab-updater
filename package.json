{
  "name": "gitlab-upgrade",
  "version": "0.1.22",
  "description": "Safe, unattended upgrades for self-managed GitLab Omnibus",
  "type": "module",
  "license": "MIT",
  "bin": {
    "gitlab-upgrade": "bin/gitlab-upgrade.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "src",
    "data"
  ],
  "scripts": {
    "test": "node --import ./scripts/jsx-loader.mjs --test test/*.test.js test/*.test.jsx",
    "lint": "node scripts/lint.mjs",
    "build": "node scripts/build.mjs",
    "check": "npm run lint && npm test",
    "shots": "FORCE_COLOR=3 node --import ./scripts/jsx-loader.mjs scripts/shots.jsx",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "ink": "^6.8.0",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "ink-testing-library": "^4.0.0"
  }
}
